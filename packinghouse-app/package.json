{
  "name": "packinghouse-app",
  "productName": "PRODTEC Packinghouse",
  "version": "1.0.6",
  "description": "Sistema de gestão de packinghouse — rastreabilidade, qualidade e estoque",
  "author": "MG Consultoria e Automação <mgconsultoriaautomacao@gmail.com>",
  "main": "src/main.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "make:win": "electron-forge make --platform win32 --arch x64",
    "make:linux-arm64": "electron-forge make --platform linux --arch arm64",
    "prebuild:win": "node -e \"require('fs').copyFileSync('win32-binding/build/Release/node_sqlite3.node', 'node_modules/sqlite3/build/Release/node_sqlite3.node')\"",
    "build:win": "npm run prebuild:win && electron-builder --win --x64",
    "build:win:dir": "npm run prebuild:win && electron-builder --win --x64 --dir",
    "build:linux": "electron-builder --linux deb AppImage --x64 --arm64",
    "build:all": "electron-builder --win --linux"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.104.1",
    "electron-squirrel-startup": "^1.0.1",
    "electron-updater": "^6.1.7",
    "sqlite3": "^5.1.7",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.4.0",
    "@electron-forge/maker-deb": "^7.4.0",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.4.0",
    "@electron-forge/maker-squirrel": "^7.4.0",
    "@electron-forge/maker-zip": "^7.4.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.4.0",
    "@electron-forge/plugin-fuses": "^7.4.0",
    "@electron/fuses": "^1.8.0",
    "@electron/rebuild": "^3.6.0",
    "electron": "^28.0.0",
    "electron-builder": "^26.15.3",
    "electron-reloader": "^1.2.3"
  }
}
